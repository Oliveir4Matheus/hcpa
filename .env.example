# =========================================================
# Plataforma HCPA — variáveis de ambiente (template)
# Copie para .env e ajuste para o seu ambiente local.
# Nenhum valor real deve ser commitado.
# =========================================================

# ---------- Postgres ----------
POSTGRES_DB=plataforma
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=plataforma_dev_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# DSN consumida pela API (asyncpg)
DATABASE_URL=postgresql+asyncpg://plataforma:plataforma_dev_change_me@postgres:5432/plataforma

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- API (FastAPI) ----------
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development            # development | staging | production
API_LOG_LEVEL=INFO
API_SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
API_CORS_ORIGINS=http://localhost:3000

# ---------- Web (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# ---------- Salesforce (Sprint 1) ----------
# Preenchido quando a Drica entregar a Connected App.
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_TOKEN=
