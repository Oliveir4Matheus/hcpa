# =========================================================
# Plataforma HCPA — variáveis de PRODUÇÃO / HOMOLOG (template Coolify)
# =========================================================
# Estas variáveis devem ser cadastradas no painel do Coolify
# (Resource → Environment Variables), NÃO commitadas com valores reais.
#
# As variáveis SERVICE_FQDN_* / SERVICE_URL_* abaixo são geradas pelo
# Coolify quando você marca "Generate FQDN" para os serviços `api` e
# `web` no painel. Listadas aqui apenas para referência do que o
# docker-compose.prod.yml consome.
# =========================================================

# ---------- Postgres (criar como secrets no Coolify) ----------
POSTGRES_DB=plataforma
POSTGRES_USER=plataforma
# openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------- API ----------
API_ENV=production            # use "staging" para homolog
API_LOG_LEVEL=INFO

# openssl rand -hex 32
API_SECRET_KEY=

# Master key do AES-256-GCM da camada de criptografia da PII.
# openssl rand -base64 32
# CRITICAL: NUNCA reusar entre homolog e prod; NUNCA reusar entre rotações.
ENCRYPTION_KEY=

# ---------- FQDN/URL (Coolify preenche automaticamente) ----------
# Configurar no painel Coolify (Resource → Domains).
# Homolog sugerido:
#   SERVICE_FQDN_API_8000=api.hcpa-stg.<DOMINIO>
#   SERVICE_FQDN_WEB_3000=app.hcpa-stg.<DOMINIO>
# Prod sugerido:
#   SERVICE_FQDN_API_8000=api.hcpa.<DOMINIO>
#   SERVICE_FQDN_WEB_3000=app.hcpa.<DOMINIO>
#
# Coolify gera automaticamente:
#   SERVICE_URL_API_8000=https://<FQDN_API>
#   SERVICE_URL_WEB_3000=https://<FQDN_WEB>
